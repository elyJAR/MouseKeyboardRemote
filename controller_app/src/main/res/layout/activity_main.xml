<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remote_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Connection Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/remote_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_disconnected"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/remote_accent"
            android:text="@string/connect_button"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mode Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/remote_surface"
        app:tabIndicatorColor="@color/remote_accent"
        app:tabSelectedTextColor="@color/remote_accent"
        app:tabTextColor="#9E9E9E">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_trackpad" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_dpad" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_keyboard" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Trackpad Container -->
    <LinearLayout
        android:id="@+id/containerTrackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <com.antigravity.mousekeyboard.controller.ui.TrackpadView
            android:id="@+id/trackpadView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/trackpad_bg" />

        <!-- Quick Mouse Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeftClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/remote_surface"
                android:text="L-CLICK"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnRightClick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/remote_surface"
                android:text="R-CLICK / BACK"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- D-Pad Container -->
    <LinearLayout
        android:id="@+id/containerDpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Dpad Up -->
        <Button
            android:id="@+id/btnDpadUp"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:backgroundTint="@color/remote_surface"
            android:text="▲"
            android:textColor="@color/remote_accent"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDpadLeft"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/remote_surface"
                android:text="◄"
                android:textColor="@color/remote_accent"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnDpadCenter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:backgroundTint="@color/remote_accent"
                android:text="OK"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDpadRight"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/remote_surface"
                android:text="►"
                android:textColor="@color/remote_accent"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Dpad Down -->
        <Button
            android:id="@+id/btnDpadDown"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:backgroundTint="@color/remote_surface"
            android:text="▼"
            android:textColor="@color/remote_accent"
            android:textSize="20sp" />

        <!-- System Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/remote_surface"
                android:text="HOME"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/remote_surface"
                android:text="BACK"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Keyboard Container -->
    <LinearLayout
        android:id="@+id/containerKeyboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/remote_surface"
            android:hint="@string/type_text_hint"
            android:padding="16dp"
            android:textColor="@color/white"
            android:textColorHint="#9E9E9E" />

        <Button
            android:id="@+id/btnSendText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/remote_accent"
            android:text="@string/send_text"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
